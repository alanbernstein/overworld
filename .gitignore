.DS_Store

# per-machine: which data roots and layer sets this machine uses
/config.json

# make status output
/status.html
/status.html.tmp

# layer sets live with the data, in each root's layers/ (the samples' example is in
# data/samples/layers/); an app-level layers/ folder is no longer read
/layers/

# data roots are linked in per machine (tools/link-data.sh); only samples are committed
data/*
!data/samples/
