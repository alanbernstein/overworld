# Installed as public_html/overworld/.htaccess by deploy/deploy.sh.

# Geolocation and the service worker need https
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

AddType application/manifest+json .webmanifest
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json
</IfModule>

# The service worker and configs must never be served stale
<IfModule mod_headers.c>
  <FilesMatch "^(sw\.js|config(\.local)?\.json|index\.html)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<FilesMatch "^\.">
  Require all denied
</FilesMatch>
