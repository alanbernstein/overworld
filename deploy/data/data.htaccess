# Installed as public_html/data/.htaccess by deploy/deploy.sh.

RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Each folder's _files.json listing is generated by _files.php, so it can't go
# stale. A real _files.json file wins if one exists, which is how a
# password-protected folder (which _files.php won't list) gets its listing.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^(.*/)?_files\.json$ _files.php?dir=$1 [L,QSA]

AddType application/geo+json .geojson
AddType application/gpx+xml .gpx
AddType application/vnd.google-earth.kml+xml .kml
AddType application/vnd.google-earth.kmz .kmz
AddType image/tiff .tif .tiff
AddType text/csv .csv

# geojson etc. are text and compress ~10x
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE application/json application/geo+json application/gpx+xml application/vnd.google-earth.kml+xml text/csv text/xml application/xml
</IfModule>

<FilesMatch "^\.">
  Require all denied
</FilesMatch>
